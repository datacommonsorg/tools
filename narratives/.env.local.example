# ==============================================================================
# Narratives Local Development Environment
# Copy this file to .env.local:
#   cp .env.local.example .env.local
# ==============================================================================

# Data Commons MCP endpoint (defaults to public Data Commons)
MCP_SERVER_URL=https://api.datacommons.org/mcp

# UI dev-proxy target for /agent/*
AGENT_URL=http://localhost:5001

# Data Commons API Key (Free from https://datacommons.org/api)
# Set directly for local development. Alternatively, set DC_API_KEY_SECRET to a
# Secret Manager secret name/path when testing Secret Manager resolution via ADC.
DC_API_KEY=
# DC_API_KEY_SECRET=

# Gemini API Key for local development
GEMINI_API_KEY=

# Optional Google Cloud Model Armor template resource name for screening user
# queries before classification (requires Application Default Credentials with
# `roles/modelarmor.user`; set GOOGLE_CLOUD_QUOTA_PROJECT when using local user
# ADC from `gcloud auth application-default login`):
# MODEL_ARMOR_TEMPLATE=projects/<project>/locations/<location>/templates/<template>
# GOOGLE_CLOUD_QUOTA_PROJECT=<project>

# Optional chat availability overrides. When set, they take precedence over
# `chat.enabled` and `chat.unavailable_message` in agent-config.json:
# ENABLE_CHAT=true
# UNAVAILABLE_MESSAGE=

# Transcript HMAC signing secret:
# - Leave blank/omitted for zero-config local dev: the server generates a fresh
#   random 32-byte key in memory on startup.
# - Fill this in (generate with `openssl rand -hex 32`) if you want browser chat
#   history and follow-up turns to persist across local dev server restarts.
#   (Required in multi-instance deployments like Kubernetes so all pods share a key).
# - Alternatively, set TRANSCRIPT_HMAC_SECRET_NAME to a Secret Manager secret
#   name/path when resolving from Secret Manager.
TRANSCRIPT_HMAC_SECRET=
# TRANSCRIPT_HMAC_SECRET_NAME=
