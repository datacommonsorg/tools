{
  "$comment": "Baseline branding, maintained upstream. Do not edit this file: put the keys you want to change in config/branding.json, which deploy.sh lays over the top of this one. Validated by schemas/branding.schema.json, which sets additionalProperties:false — an unrecognised key is an error, not a silent no-op. See Customising in README.md.",
  "instance_id": "example",
  "instance_name": "Example Data Commons",
  "domain_hint": "example.org",
  "logo": "assets/logo.png",
  "logo_alt": "Example Data Commons",
  "favicon": "assets/logo.png",
  "colors": {
    "primary": "#1A73E8",
    "accent": "#34A853",
    "text": "#3C4043",
    "text_muted": "#5F6368",
    "background": "#FFFFFF",
    "surface": "#F8F9FA",
    "gradient_start": "#65A782",
    "gradient_end": "#6FAEC0"
  },
  "fonts": {
    "primary": "Google Sans, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
    "body": "Google Sans Text, system-ui, -apple-system, BlinkMacSystemFont, sans-serif"
  },
  "extra_css": "assets/overrides.css",
  "navigation": [
    { "label": "Home", "href": "/" },
    { "label": "Data Agent", "href": "/agent" },
    { "label": "Explore", "href": "/explore" },
    { "label": "Browser", "href": "/browser" },
    { "label": "About", "href": "/about" }
  ],
  "suggestions": [
    "How has population changed over the last decade?",
    "Compare GDP per capita across countries",
    "Show life expectancy trends",
    "Which regions have the highest unemployment?",
    "Plot CO2 emissions per capita over time"
  ],
  "footer": {
    "text": "Example Data Commons — built on Custom Data Commons.",
    "links": [
      { "label": "About", "href": "/about" },
      { "label": "FAQ", "href": "/faq" },
      { "label": "Disclaimers", "href": "/disclaimers" }
    ]
