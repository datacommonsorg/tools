  "analytics": {
    "ga_tag_id": ""
  },
  "metrics": {
    "$comment": "Example dashboard, read by the UI's MetricsPage at mount. Every variable and place below exists in BASE Data Commons, so this renders as-is on DATA_BACKEND=none with nothing ingested — it is a working starting point, not a suggestion of what your instance should show. Replace the tiles with your own DCIDs. Place DCIDs follow Data Commons conventions (country/XXX, geoId/NN, wikidataId/Q####); childPlaceType is the type being aggregated, e.g. Country, State, AdministrativeArea1.",
    "tabs": [
      {
        "id": "population",
        "label": "Population",
        "tiles": [
          { "type": "highlight", "title": "World population", "header": "World population", "variable": "Count_Person", "place": "Earth" },
          {
            "type": "line",
            "title": "Population over time",
            "header": "Population over time",
            "variables": "Count_Person",
            "places": "country/USA country/CHN country/IND country/BRA"
          },
          {
            "type": "map",
            "title": "Population by country",
            "header": "Population by country",
            "variable": "Count_Person",
            "parentPlace": "Earth",
            "childPlaceType": "Country"
          },
          {
            "type": "ranking",
            "title": "Most populous countries",
            "header": "Most populous countries",
            "variable": "Count_Person",
            "parentPlace": "Earth",
            "childPlaceType": "Country",
            "rankingCount": 10
          }
        ]
      },
      {
        "id": "economy",
        "label": "Economy",
        "tiles": [
          {
            "type": "line",
            "title": "GDP per capita",
            "header": "Nominal GDP per capita",
            "variables": "Amount_EconomicActivity_GrossDomesticProduction_Nominal_PerCapita",
            "places": "country/USA country/CHN country/IND country/BRA"
          },
          {
            "type": "map",
            "title": "GDP per capita by country",
            "header": "GDP per capita by country",
            "variable": "Amount_EconomicActivity_GrossDomesticProduction_Nominal_PerCapita",
            "parentPlace": "Earth",
            "childPlaceType": "Country"
          }
        ]
      },
      {
        "id": "environment",
        "label": "Environment",
        "tiles": [
          {
            "type": "line",
            "title": "Per-capita CO2 emissions",
            "header": "Annual CO2 emissions per capita",
            "variables": "Amount_Emissions_CarbonDioxide_PerCapita",
            "places": "country/USA country/CHN country/IND country/GBR"
          }
        ]
      }
    ]
  }
}
