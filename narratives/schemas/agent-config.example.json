{
  "$schema": "./agent-config.schema.json",
  "$comment": "Canonical example mirroring additional_features/config.json.example. The deployment inherits defaults/agent-config.json and may override it with config/agent-config.json; deploy.sh lays the second over the first before uploading.",

  "gemini": {
    "api_keys": [
      "REPLACE_ME_OR_USE_SECRET_MANAGER_1",
      "REPLACE_ME_OR_USE_SECRET_MANAGER_2",
      "REPLACE_ME_OR_USE_SECRET_MANAGER_3"
    ],
    "demo_api_keys": [
      "REPLACE_ME_DEMO_KEY_1",
      "REPLACE_ME_DEMO_KEY_2",
      "REPLACE_ME_DEMO_KEY_3"
    ],
    "api_base": "https://generativelanguage.googleapis.com/v1beta/models",
    "mcp_model": "gemini-3-flash-preview",
    "kb_model": "gemini-3-flash-preview",
    "filestores": [
      "fileSearchStores/REPLACE_ME"
    ],
    "demo_filestores": []
  },

  "mcp": {
    "server_url": "http://127.0.0.1:8082",
    "enabled": true
  },

  "knowledge_base": {
    "enabled": false
  },

  "thinking": {
    "mcp_level": "medium",
    "synthesis_level": "medium"
  },

  "template_vars": {
    "name": "Custom Data Commons",
    "region": "global",
    "states_term": "regions",
    "fiscal_year_start": "01-01"
  },

  "query_param_key": "REPLACE_ME_PER_INSTANCE"
}
