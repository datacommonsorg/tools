# ===========================================================================
# INSTANCE CONFIGURATION
# ===========================================================================
#
# This repository is ONE deployment. Clone it per instance; do not try to run
# two instances from one checkout.
#
#   git clone <repo> acme-dc && cd acme-dc
#   $EDITOR config/instance.env          <- you are here
#   ./deploy.sh --preflight              <- checks everything, creates nothing
#   DC_API_KEY=... GEMINI_API_KEY=... ./deploy.sh --bootstrap-secrets
#   ./deploy.sh
#
# NO SECRETS IN THIS FILE, ever. API keys go to Secret Manager via
# --bootstrap-secrets, which reads them from your shell and writes nothing to
# disk.
#
# Every value in sections 1 and 3 is REQUIRED and has no default. That is
# deliberate: each one decides where your data lives, what it costs, or who can
# reach it, and a silent default for any of them is a decision made on your
# behalf that you would not see until the bill or the latency showed up.
# ===========================================================================


# ── 1. Where it runs ───────────────────────────────────────────────────────

# Your GCP project id. Billing must be enabled on it.
PROJECT_ID=""

# The region for Cloud Run, buckets and Artifact Registry.
# There is deliberately no default. Pick the one closest to your users, and
# check your data-residency obligations before you do — moving afterwards
# means recreating everything.
#   e.g. us-central1 · europe-west1 · asia-south1
REGION=""

# Short name for this deployment. Lowercase, DNS-safe.
# Names every resource and the Terraform state prefix, so two clones pointed at
# one project stay separate: acme-prod and acme-staging never collide.
INSTANCE=""


# ── 2. Which Data Commons serves it ────────────────────────────────────────
#
# Public datacommons.org. Optional: left empty, each value takes the standard
# host shown below.
#
# TWO hosts, not one. Getting it wrong produces a deployment where chat answers
# correctly and no chart ever renders: the browser's requests reach a host that
# does not serve those routes and come back as Cloud Endpoints 404s, which
# nothing surfaces server-side.
#
#   PUBLIC_DC_URL      the versioned REST API, and /mcp -- what the AGENT calls.
#                      The agent's MCP endpoint is this value with /mcp appended.
#   PUBLIC_DC_WEB_URL  the website routes the chart components call from the
#                      BROWSER: /api/observations/series, /api/place/name,
#                      /core/api/... These exist only on the website host.
#
# Standard values, used when these are empty, and what you want unless you are
# pointing at a different public Data Commons deployment:
#   PUBLIC_DC_URL="https://api.datacommons.org"
#   PUBLIC_DC_WEB_URL="https://datacommons.org"
PUBLIC_DC_URL=""
PUBLIC_DC_WEB_URL=""


# ── 3. Who can reach it ────────────────────────────────────────────────────
#
#   public   Anyone with the URL. This includes the chat endpoint, so it
#            spends your Gemini quota on every request from anyone.
#            Many organizations forbid this — see the note below.
#   iap      Google sign-in in front of the app. Only AUTHORIZED_MEMBERS get
#            in. Requires one manual step, once per project: create the OAuth
#            consent screen in the console. ./deploy.sh --preflight checks it.
#   private  No public access and no sign-in. Reach it only through
#            `gcloud run services proxy`. Good for a pilot you drive yourself.
#
# If your organization enforces Domain Restricted Sharing, "public" will be
# refused and you want "iap". --preflight detects this before deploying.
ACCESS_MODE=""

# Comma-separated. Each entry prefixed user: or group:.
# Required for "iap" and "private". Leave empty for "public".
#   e.g. group:data-team@acme.com,user:ana@acme.com
AUTHORIZED_MEMBERS=""


# ── 4. Optional ────────────────────────────────────────────────────────────

# Defaults to <PROJECT_ID>-<INSTANCE>-config. Set only to keep an existing
# deployment pointed at a bucket it already uses.
#CONFIG_BUCKET=""
