# ==============================================================================
# Narratives Local Development Environment
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# Data Commons data plane & MCP endpoints (defaults to public Data Commons)
MCP_SERVER_URL=https://api.datacommons.org/mcp
DATA_PLANE_URL=https://api.datacommons.org
DATA_PLANE_WEB_URL=https://datacommons.org

# UI dev-proxy targets
BACKEND_URL=https://datacommons.org
AGENT_URL=http://localhost:5001

# Data Commons API Key (Free from https://datacommons.org/api)
DC_API_KEY=

# Gemini API Key for local development
GEMINI_API_KEY=
