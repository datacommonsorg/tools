[MASTER]
ignore=venv,.venv,node_modules

[MESSAGES CONTROL]
# Disable some checks that are overly verbose or not strictly part of Google style
disable=C0330,C0326

[FORMAT]
max-line-length=80
indent-string='    '

[BASIC]
# Naming conventions conforming to Google Style
const-rgx=[A-Z_][A-Z0-9_]*$
class-rgx=[A-Z_][a-zA-Z0-9]+$
function-rgx=[a-z_][a-z0-9_]*$
method-rgx=[a-z_][a-z0-9_]*$
variable-rgx=[a-z_][a-z0-9_]*$
argument-rgx=[a-z_][a-z0-9_]*$
