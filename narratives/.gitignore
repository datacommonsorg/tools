# Dependencies
node_modules

# Build output
dist
*.tsbuildinfo

# Local env (per-developer; never commit)
# Holds BACKEND_URL / AGENT_URL pointing at a specific deployed instance.
# Each developer creates their own.
.env
.env.local
.env.*.local

# The agent's local config. A deployed instance fetches its config from the
# instance bucket via CONFIG_URL and reads API keys from Secret Manager, so this
# file only exists for local development — where it holds real Gemini keys.
# Never commit it.
agent/config.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite cache
.vite

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode
.idea
*.swp
*.swo

# Coverage
coverage

# Project-specific (preserved from prior .gitignore)
figma_*
screenshots
.gemini
.figma_pat
# Ignore stray Python scripts at the project root, but keep the agent
# sidecar's source (agent/ and its subpackages) tracked — it is part of the app.
*.py
!agent/**/*.py
sample.js

# Redundant snapshot of the original AI Studio scaffold
Archive.zip
deploy.env
