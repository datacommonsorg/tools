# ── OS / editor cruft ──
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# ── React UI (ui/) ──
ui/node_modules
ui/dist

# Compiled SPA staged into the agent build context by build.sh / deploy.sh.
agent/static/
ui/*.tsbuildinfo
ui/.env
ui/.env.local
ui/.env.*.local
ui/coverage
ui/.vite

# ── Built artefacts from image/build.sh ──
# dist/ is staged in image/ at build time from ui/dist/. Don't commit either.
image/dist

# ── Terraform state + downloaded providers ──
deploy/**/.terraform/
# Per-instance Terraform data dirs (TF_DATA_DIR=.terraform-<instance>),
# so concurrent instance deploys do not race on one backend pointer.
deploy/**/.terraform-*/
deploy/**/.terraform.lock.hcl
deploy/**/*.tfstate
deploy/**/*.tfstate.*
deploy/**/*.tfstate.backup
# Generated per-instance tfvars (e.g. india.tfvars) — rendered from
# new-instance.tfvars.sample at deploy time. The .sample / .historical
# reference files don't end in .tfvars, so they stay tracked.
deploy/**/*.tfvars
deploy/**/tfplan.*
deploy/**/tfapply*.log

# ── Python ──
__pycache__/
*.pyc
*.pyo
agent/venv/
agent/.venv/
agent/config.json
agent/logs/

# ── Local AI/assistant instruction files (never committed) ──
/*.local.md
/AGENTS.md

# ── Local secrets ──
.env
.env.local
.env.*.local
*.key
service-account*.json
credentials*.json

# Local deploy secrets (never commit)
deploy.env

# ── This deployment's configuration ──
# config/ is COMMITTED, deliberately. One clone of this repository is one
# deployment, and config/ is what makes this clone that deployment -- losing it
# to .gitignore would mean re-deriving the settings by hand after every clone.
#
# Which means: KEEP YOUR CLONE PRIVATE. config/instance.env names the GCP
# project, the region, the data-plane URL (which embeds the project NUMBER) and
# everyone allowed to reach the service. All of that is disclosure on its own.
#
# API keys are never committed under any circumstance. They live only in Secret
# Manager, written once by ./deploy.sh --bootstrap-secrets, which reads them
# from the environment and writes nothing to disk.

# Staging directory for the config bucket: defaults/ with config/ laid over it,
# rebuilt on every deploy.
.build/

# datacommons-cli terraform scaffold — regenerated by `admin init`, not source.
india/
